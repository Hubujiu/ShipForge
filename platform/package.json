{
  "name": "shipforge-workspace",
  "version": "0.17.0",
  "private": true,
  "description": "An open-source workspace for people and agents",
  "author": "ShipForge contributors",
  "main": "build/desktop/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && webpack --mode production && node scripts/copy-assets.cjs",
    "start": "electron .",
    "server": "node build/server/index.js",
    "cli": "node build/cli.js",
    "schema": "node scripts/sync-schema.cjs",
    "test": "node --test tests/*.test.cjs",
    "package:windows": "electron-builder --win nsis zip --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pg": "^8.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "ts-loader": "^9.5.0",
    "typescript": "~5.9.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.shipforge.workspace",
    "productName": "ShipForge",
    "artifactName": "ShipForge-${version}-windows-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["build/desktop/**", "build/renderer/**", "build/transport.js", "package.json"],
    "extraResources": [{"from": "build/worker", "to": "worker", "filter": ["shipforge-worker.exe"]}],
    "win": { "target": ["nsis", "zip"], "signExecutable": false },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "runAfterFinish": false,
      "artifactName": "ShipForge-${version}-windows-${arch}-setup.${ext}"
    }
  }
}

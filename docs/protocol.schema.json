{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "list",
              "get",
              "create",
              "update",
              "delete"
            ]
          }
        }
      },
      "then": {
        "required": [
          "kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "get",
              "update",
              "delete",
              "view.run",
              "iteration.preview",
              "iteration.close",
              "triage",
              "follow",
              "document.history",
              "document.restore",
              "artifact.save",
              "notification.act",
              "task.relations",
              "project.progress"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "create"
          }
        }
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "provider.preview",
              "provider.ingest"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "enum": [
              "github",
              "gitlab",
              "jira",
              "feishu",
              "lark",
              "slack",
              "telegram",
              "linear",
              "asana",
              "teams",
              "discord",
              "wecom",
              "dingtalk"
            ]
          }
        },
        "required": [
          "id",
          "provider",
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "attachment.upload"
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "artifact",
                "message",
                "task"
              ]
            }
          }
        },
        "properties": {
          "kind": {
            "enum": [
              "document",
              "artifact",
              "message",
              "task"
            ]
          }
        },
        "required": [
          "kind",
          "filename",
          "content_base64"
        ],
        "then": {
          "required": [
            "id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "attachment.download"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "document",
              "artifact",
              "message",
              "task"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "attachment_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "onboarding.setup"
          }
        }
      },
      "then": {
        "properties": {
          "organization_name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "organization_slug": {
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "organization_name",
          "organization_slug",
          "work_type",
          "task_types"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "onboarding.display"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "sidebar_visible"
            ]
          },
          {
            "required": [
              "sidebar_expanded"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent"
          },
          "op": {
            "enum": [
              "create",
              "update"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "fields": {
            "properties": {
              "working_hours": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "not": {
                      "required": [
                        "week"
                      ]
                    },
                    "properties": {
                      "end": {
                        "maximum": 23,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "start": {
                        "maximum": 23,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "utc_offset_minutes": {
                        "maximum": 840,
                        "minimum": -840,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "type": "object"
                  },
                  {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "start"
                          ]
                        },
                        {
                          "required": [
                            "end"
                          ]
                        },
                        {
                          "required": [
                            "utc_offset_minutes"
                          ]
                        }
                      ]
                    },
                    "properties": {
                      "timezone": {
                        "description": "IANA time zone",
                        "minLength": 1,
                        "type": "string"
                      },
                      "week": {
                        "additionalProperties": {
                          "items": {
                            "properties": {
                              "end": {
                                "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$",
                                "type": "string"
                              },
                              "start": {
                                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ],
                            "type": "object"
                          },
                          "maxItems": 2,
                          "type": "array"
                        },
                        "propertyNames": {
                          "pattern": "^[1-7]$"
                        },
                        "type": "object"
                      }
                    },
                    "required": [
                      "timezone",
                      "week"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "agent.resolve",
              "catalog.install",
              "machine.enable",
              "machine.disable",
              "run.cancel",
              "run.retry"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "tool.authorize"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "tool_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "machine.register"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key",
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "machine.heartbeat",
              "run.claim"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.heartbeat",
              "run.report",
              "run.tool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key",
          "id",
          "lease"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.tool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "tool_id",
          "call_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.report"
            ]
          }
        }
      },
      "then": {
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.reply"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.enqueue"
            ]
          }
        }
      },
      "then": {
        "required": [
          "handler_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "automation.fire"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "event_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "connector.ingest"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "external_id",
          "event_id",
          "source_version",
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "connector.export"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "task_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "run.report"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "maxItems": 100,
            "type": "array"
          },
          "status": {
            "enum": [
              "done",
              "failed",
              "cancelled",
              "waiting"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "invitation.issue"
          }
        }
      },
      "then": {
        "else": {
          "properties": {
            "role": {
              "enum": [
                "member",
                "guest"
              ]
            }
          }
        },
        "if": {
          "properties": {
            "channel": {
              "const": "email"
            }
          }
        },
        "properties": {
          "channel": {
            "enum": [
              "email",
              "link"
            ]
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "expires_at": {
            "type": "integer"
          },
          "role": {
            "enum": [
              "member",
              "guest",
              "admin"
            ]
          },
          "spaces": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "channel",
          "role"
        ],
        "then": {
          "required": [
            "email"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "invitation.copy",
              "invitation.revoke"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "invitation.accept"
          }
        }
      },
      "then": {
        "properties": {
          "link": {
            "pattern": "^shipforge://invite/",
            "type": "string"
          }
        },
        "required": [
          "link"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "chat.info",
              "chat.manage",
              "chat.preferences"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "chat.manage"
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "action": {
              "enum": [
                "add",
                "remove",
                "invite",
                "revoke",
                "transfer"
              ]
            }
          }
        },
        "properties": {
          "action": {
            "enum": [
              "add",
              "remove",
              "invite",
              "accept",
              "decline",
              "revoke",
              "transfer",
              "leave",
              "dissolve",
              "clear"
            ]
          },
          "target_kind": {
            "enum": [
              "member",
              "agent"
            ]
          }
        },
        "required": [
          "action"
        ],
        "then": {
          "properties": {
            "target": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "target"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "chat.preferences"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "muted"
            ]
          },
          {
            "required": [
              "ignore_all"
            ]
          }
        ],
        "properties": {
          "ignore_all": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "chat.share.create"
          }
        }
      },
      "then": {
        "properties": {
          "message_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "scope": {
            "enum": [
              "organization",
              "link"
            ]
          }
        },
        "required": [
          "id",
          "message_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "chat.share.read",
              "chat.share.revoke"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "share": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "share"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "chat.share.revoke"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.bind",
              "im.unbind"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "provider",
          "payload",
          "task_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.outbox",
              "im.claim"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.threads"
            ]
          }
        }
      },
      "then": {
        "required": [
          "task_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.reply"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "task_id",
          "thread",
          "body",
          "request_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.ack"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "delivery_id",
          "lease",
          "outcome"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "im.retry"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "delivery_id",
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "im.ack"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "sent",
              "retry",
              "uncertain",
              "failed"
            ]
          },
          "retry_after": {
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "im.retry"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "resend",
              "confirm"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "im.outbox"
          }
        }
      },
      "then": {
        "properties": {
          "available_only": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "pending",
              "leased",
              "uncertain",
              "failed",
              "sent",
              "cancelled"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "preferences.update"
          }
        }
      },
      "then": {
        "required": [
          "preferences"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "task.assign"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "assignees"
            ]
          },
          {
            "required": [
              "executor"
            ]
          }
        ],
        "dependentRequired": {
          "mode": [
            "assignees"
          ]
        },
        "properties": {
          "mode": {
            "enum": [
              "append",
              "replace"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          },
          "op": {
            "enum": [
              "create",
              "update"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "fields": {
            "properties": {
              "assignees": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "executor": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "agent",
                          "crew"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "task.move"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "target"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "task.conversation",
              "task.command"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "access.issue"
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "access.revoke"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "sync.enqueue"
          }
        }
      },
      "then": {
        "required": [
          "request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "sync.resolve"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    }
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "after": {
      "minimum": 0,
      "type": "integer"
    },
    "allow_cached": {
      "type": "boolean"
    },
    "as_of": {
      "format": "date",
      "type": "string"
    },
    "assignees": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "attachment_id": {
      "type": "string"
    },
    "call_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "capacity": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "chat_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "content_base64": {
      "contentEncoding": "base64",
      "maxLength": 5592408,
      "type": "string"
    },
    "event_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "executor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "enum": [
                "agent",
                "crew"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }

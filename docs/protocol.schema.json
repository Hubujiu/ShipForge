{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "list",
              "get",
              "create",
              "update",
              "delete"
            ]
          }
        }
      },
      "then": {
        "required": [
          "kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "get",
              "update",
              "delete",
              "view.run",
              "iteration.preview",
              "iteration.close",
              "triage",
              "follow",
              "document.history",
              "document.restore",
              "artifact.save",
              "notification.act",
              "task.relations",
              "project.progress"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "create"
          }
        }
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "provider.preview",
              "provider.ingest"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "enum": [
              "gitlab",
              "jira",
              "feishu",
              "lark",
              "slack",
              "telegram"
            ]
          }
        },
        "required": [
          "id",
          "provider",
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "attachment.upload"
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "artifact",
                "message",
                "task"
              ]
            }
          }
        },
        "properties": {
          "kind": {
            "enum": [
              "document",
              "artifact",
              "message",
              "task"
            ]
          }
        },
        "required": [
          "kind",
          "filename",
          "content_base64"
        ],
        "then": {
          "required": [
            "id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "attachment.download"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "document",
              "artifact",
              "message",
              "task"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "attachment_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "agent.resolve",
              "catalog.install",
              "machine.enable",
              "machine.disable",
              "run.cancel",
              "run.retry"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "tool.authorize"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "tool_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "machine.register"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key",
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "machine.heartbeat",
              "run.claim"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.heartbeat",
              "run.report",
              "run.tool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "machine_id",
          "machine_key",
          "id",
          "lease"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.tool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "tool_id",
          "call_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.report"
            ]
          }
        }
      },
      "then": {
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.reply"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "run.enqueue"
            ]
          }
        }
      },
      "then": {
        "required": [
          "handler_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "automation.fire"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "event_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "connector.ingest"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "external_id",
          "event_id",
          "source_version",
          "title"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": [
              "connector.export"
            ]
          }
        }
      },
      "then": {
        "required": [
          "id",
          "task_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "run.report"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "maxItems": 100,
            "type": "array"
          },
          "status": {
            "enum": [
              "done",
              "failed",
              "cancelled",
              "waiting"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "access.issue"
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "access.revoke"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "sync.enqueue"
          }
        }
      },
      "then": {
        "required": [
          "request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "sync.resolve"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ]
      }
    }
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "after": {
      "minimum": 0,
      "type": "integer"
    },
    "allow_cached": {
      "type": "boolean"
    },
    "attachment_id": {
      "type": "string"
    },
    "call_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "capacity": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "chat_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "content_base64": {
      "contentEncoding": "base64",
      "maxLength": 5592408,
      "type": "string"
    },
    "event_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "expected_rev": {
      "minimum": 1,
      "type": "integer"
    },
    "external_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "filename": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "filter": {
      "type": "object"
    },
    "handler_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "handler_kind": {
      "enum": [
        "agent",
        "crew"
      ]
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "space",
        "organization",
        "member",
        "task",
        "task_type",
        "status",
        "field",
        "tag",
        "relation",
        "relation_type",
        "view",
        "iteration",
        "project",
        "comment",
        "notification",
        "chat",
        "message",
        "document",
        "artifact",
        "agent",
        "crew",
        "skill",
        "machine",
        "run",
        "automation",
        "connector",
        "tool",
        "settings",
        "invitation",
        "note"
      ],
      "type": "string"
    },
    "lease": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "limit": {
      "maximum": 5000,
      "minimum": 1,
      "type": "integer"
    },
    "machine_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "machine_key": {
      "maxLength": 256,
      "minLength": 32,
      "type": "string",
      "writeOnly": true
    },
    "media_type": {
      "type": "string"
    },
    "offset": {
      "minimum": 0,
      "type": "integer"
    },
    "op": {
      "enum": [
        "schema",
        "whoami",
        "list",
        "get",
        "search",
        "space.list",
        "organization.list",
        "events",
        "view.run",
        "dashboard",
        "iteration.preview",
        "task.relations",
        "project.progress",
        "document.history",
        "export",
        "import.preview",
        "provider.preview",
        "attachment.download",
        "create",
        "update",
        "delete",
        "iteration.close",
        "triage",
        "follow",
        "notification.act",
        "document.restore",
        "artifact.save",
        "import",
        "provider.ingest",
        "attachment.upload",
        "agent.resolve",
        "catalog.list",
        "catalog.install",
        "tool.authorize",
        "machine.register",
        "machine.heartbeat",
        "machine.disable",
        "machine.enable",
        "run.enqueue",
        "run.claim",
        "run.heartbeat",
        "run.report",
        "run.cancel",
        "run.retry",
        "run.reply",
        "run.tool",
        "automation.fire",
        "automation.tick",
        "connector.ingest",
        "connector.export",
        "access.whoami",
        "access.issue",
        "access.list",
        "access.revoke",
        "sync.status",
        "sync.pending",
        "sync.enqueue",
        "sync.flush",
        "sync.resolve"
      ],
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "provider": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "queue_if_offline": {
      "type": "boolean"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "runtimes": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "scope": {
      "enum": [
        "read",
        "write",
        "worker",
        "hook"
      ]
    },
    "source_version": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "space": {
      "default": "default",
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "tool_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "op"
  ],
  "title": "ShipForge workspace request",
  "type": "object"
}
